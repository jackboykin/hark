; hark: root-hints = 127.0.10.1
; hark: dns64-prefix = 64:ff9b::/96
; hark: qname-minimisation = no

SCENARIO_BEGIN ipv4only.arpa, real AAAA, CD=1, synthesis, and a CNAME chain

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.example.com.
    SECTION ADDITIONAL
      ns.example.com. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      dual.example.com. IN AAAA
    SECTION ANSWER
      dual.example.com. 3600 IN AAAA 2001:db8::1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      dual.example.com. IN A
    SECTION ANSWER
      dual.example.com. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      v4only.example.com. IN AAAA
    SECTION AUTHORITY
      example.com. 300 IN SOA ns.example.com. hostmaster.example.com. 1 7200 3600 1209600 300
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN AAAA
    SECTION ANSWER
      www.example.com. 3600 IN CNAME host.example.com.
    SECTION AUTHORITY
      example.com. 300 IN SOA ns.example.com. hostmaster.example.com. 1 7200 3600 1209600 300
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      host.example.com. IN AAAA
    SECTION AUTHORITY
      example.com. 300 IN SOA ns.example.com. hostmaster.example.com. 1 7200 3600 1209600 300
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 3600 IN CNAME host.example.com.
      host.example.com. 3600 IN A 192.0.2.33
      host.example.com. 3600 IN A 198.51.100.7
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      host.example.com. IN A
    SECTION ANSWER
      host.example.com. 3600 IN A 192.0.2.33
      host.example.com. 3600 IN A 198.51.100.7
  ENTRY_END
RANGE_END

; RFC 8880 §7.1: both halves are local, nothing goes upstream.
STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    ipv4only.arpa. IN AAAA
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    ipv4only.arpa. IN AAAA
  SECTION ANSWER
    ipv4only.arpa. 600 IN AAAA 64:ff9b::c000:aa
    ipv4only.arpa. 600 IN AAAA 64:ff9b::c000:ab
ENTRY_END

STEP 3 CHECK_MAX_QUERIES 0

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    dual.example.com. IN AAAA
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    dual.example.com. IN AAAA
  SECTION ANSWER
    dual.example.com. 3600 IN AAAA 2001:db8::1
ENTRY_END

STEP 6 QUERY
ENTRY_BEGIN
  REPLY RD CD
  SECTION QUESTION
    v4only.example.com. IN AAAA
ENTRY_END

STEP 7 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    v4only.example.com. IN AAAA
ENTRY_END

STEP 8 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN AAAA
ENTRY_END

; TTL capped by the negative's SOA (300 < 3600).
STEP 9 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN AAAA
  SECTION ANSWER
    www.example.com. 3600 IN CNAME host.example.com.
    host.example.com. 300 IN AAAA 64:ff9b::c000:221
    host.example.com. 300 IN AAAA 64:ff9b::c633:6407
ENTRY_END

SCENARIO_END

  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    handed.example. IN A
ENTRY_END

STEP 18 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    quiet.example. IN A
ENTRY_END

STEP 19 CHECK_ANSWER

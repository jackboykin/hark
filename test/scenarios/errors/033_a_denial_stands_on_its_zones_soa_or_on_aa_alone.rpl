; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no

SCENARIO_BEGIN a denial stands on its zone's SOA, or on AA alone for no time

; RFC 2308 §2.2, §3, §5. A denial carries an SOA at or above the name
; denied. One naming no zone at all, AA set and neither SOA nor NS beside
; it, is served and never remembered. An SOA of another zone denies
; nothing, nor does NS without the zone's own on either rcode, nor a reply
; without AA. AA speaks for the first owner alone (RFC 1034 §6.2.7), so an
; NXDOMAIN past an alias without its SOA leaves the alias, and the target
; is asked itself. An NXDOMAIN carrying a cut is no referral.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      lost.org. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 300
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      gone.example. IN A
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      empty.example. IN A
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      denied.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. root.example. 1 3600 900 604800 300
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      odd.example. IN A
    SECTION AUTHORITY
      other.example. 3600 IN SOA ns.example. root.example. 1 3600 900 604800 300
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      handed.example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      quiet.example. IN A
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      chain.example. IN A
    SECTION ANSWER
      chain.example. 3600 IN CNAME lost.example.
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      lost.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. root.example. 1 3600 900 604800 300
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR NXDOMAIN
    SECTION QUESTION
      www.sub.example. IN A
    SECTION AUTHORITY
      sub.example. 3600 IN NS ns.sub.example.
    SECTION ADDITIONAL
      ns.sub.example. 3600 IN A 127.0.10.3
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR NXDOMAIN
    SECTION QUESTION
      hop.sub.example. IN A
    SECTION ANSWER
      hop.sub.example. 3600 IN CNAME lost.org.
    SECTION AUTHORITY
      sub.example. 3600 IN NS ns.sub.example.
    SECTION ADDITIONAL
      ns.sub.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.sub.example. IN A
    SECTION ANSWER
      www.sub.example. 300 IN A 192.0.2.9
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      hop.sub.example. IN A
    SECTION ANSWER
      hop.sub.example. 300 IN A 192.0.2.9
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer authority
  REPLY QR RD RA NXDOMAIN
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 3 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 4 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer authority
  REPLY QR RD RA NXDOMAIN
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 7 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    gone.example. IN A
ENTRY_END

STEP 8 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    empty.example. IN A
ENTRY_END

STEP 9 CHECK_ANSWER
ENTRY_BEGIN

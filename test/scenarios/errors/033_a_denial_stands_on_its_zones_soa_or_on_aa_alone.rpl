ENTRY_END

STEP 11 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer authority
  REPLY QR RD RA NXDOMAIN
  SECTION QUESTION
    denied.example. IN A
  SECTION AUTHORITY
    example. 300 IN SOA ns.example. root.example. 1 3600 900 604800 300
ENTRY_END

STEP 12 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    www.sub.example. IN A
ENTRY_END

STEP 13 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question ede=22
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.sub.example. IN A
ENTRY_END

STEP 14 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    odd.example. IN A
ENTRY_END

STEP 15 CHECK_ANSWER
ENTRY_BEGIN

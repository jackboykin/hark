  ADDRESS 127.0.10.4
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.5
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.6
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.7
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.8
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.9
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=22
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=13
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 5 CHECK_MAX_QUERIES 17

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: client-timeout = 20
; sim-only: live, a UDP client is answered within 2 s or not at all, long before eight silent servers are spent

SCENARIO_BEGIN a zone whose every server is silent is held for the window, deadline or not

; Eight silent servers, each asked twice, outlast the asker's deadline.
; Every server was asked, so the failure is the zone's, not the
; deadline's: it is remembered (RFC 9520 §3.2), and the question is then
; refused from memory.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns1.example.
      example. 3600 IN NS ns2.example.
      example. 3600 IN NS ns3.example.
      example. 3600 IN NS ns4.example.
      example. 3600 IN NS ns5.example.
      example. 3600 IN NS ns6.example.
      example. 3600 IN NS ns7.example.
      example. 3600 IN NS ns8.example.
    SECTION ADDITIONAL
      ns1.example. 3600 IN A 127.0.10.2
      ns2.example. 3600 IN A 127.0.10.3
      ns3.example. 3600 IN A 127.0.10.4
      ns4.example. 3600 IN A 127.0.10.5
      ns5.example. 3600 IN A 127.0.10.6
      ns6.example. 3600 IN A 127.0.10.7
      ns7.example. 3600 IN A 127.0.10.8
      ns8.example. 3600 IN A 127.0.10.9
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END


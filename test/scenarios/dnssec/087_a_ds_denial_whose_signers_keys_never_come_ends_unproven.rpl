; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = c.x.example.

SCENARIO_BEGIN a DS denial whose signer's keys never come ends unproven, and its bytes go

; As 065, but example.'s server never answers x.example. DS, so the forged
; signer is never proven no zone: the denial fails to validate on the
; fetch, not on a proof. Bytes that fail to validate have no TTL to trust,
; whatever stopped them (RFC 4035 §4.7), and the forger chose the signer
; whose keys they wait on. Validating c.x.example. never needs x.example.:
; once the forger is gone, the referral is asked for again and the child
; validates under example., x.example. still unanswered.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      x.example. IN DS
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      c.x.example. IN A
    SECTION AUTHORITY
      c.x.example. 3600 IN NS ns.c.x.example.
      c.x.example. 3600 IN NSEC d.x.example. NS RRSIG NSEC
      c.x.example. 3600 IN RRSIG NSEC 13 3 3600 20990101000000 20200101000000 1 x.example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION ADDITIONAL
      ns.c.x.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      c.x.example. IN A
    SECTION AUTHORITY
      c.x.example. 3600 IN NS ns.c.x.example.
      c.x.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.c.x.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.c.x.example. IN A
    SECTION ANSWER
      www.c.x.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

; The fetch's failure, not a bogus verdict: nothing was proven.
STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=22
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 10

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

SCENARIO_END

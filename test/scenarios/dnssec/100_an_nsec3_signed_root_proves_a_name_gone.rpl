; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .

SCENARIO_BEGIN an NSEC3-signed root proves a name gone: the root is its closest encloser

; Under the root, the zone apex is the root itself: the closest encloser
; of a TLD (RFC 5155 §8.3).
;
; BEKJ…U2F is the root, 3H93…7TB sits just below b., 6HLR…T99 just below *.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      BEKJP7DGPVSJUKLL47BK43I3URMQ4U2F. 3600 IN NSEC3 1 0 0 - BEKJP7DGPVSJUKLL47BK43I3URMQ4U2G NS SOA RRSIG DNSKEY NSEC3PARAM
      3H93IG30VC08KIVCHNDQOR669TPLS7TB. 3600 IN NSEC3 1 0 0 - 3H93IG30VC08KIVCHNDQOR669TPLS7TD A RRSIG
      6HLRM49H778HN670802MJDFGCGCQCT99. 3600 IN NSEC3 1 0 0 - 6HLRM49H778HN670802MJDFGCGCQCT9B A RRSIG
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    b. IN A
  SECTION ANSWER
ENTRY_END

STEP 3 CHECK_MAX_QUERIES 2

SCENARIO_END

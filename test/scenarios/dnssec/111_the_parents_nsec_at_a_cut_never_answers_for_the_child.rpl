; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN the parent's NSEC at a cut never answers for the child

; Two NSECs sit at example. (RFC 4035 §5.3.2): the root's at its
; delegation and the child's at its apex. Only the child's answers there
; (step 4), and its arrival takes nothing from the root's index (step 8).

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    SIGN_AS .
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      f. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN NSEC example. SOA NS DNSKEY RRSIG NSEC
      example. 3600 IN NSEC z. NS DS RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN NSEC
    SECTION ANSWER
      example. 3600 IN NSEC a.example. NS SOA RRSIG NSEC DNSKEY
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      nope.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      example. 3600 IN NSEC a.example. NS SOA RRSIG NSEC DNSKEY
      a.example. 3600 IN NSEC z.example. A RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    f. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    f. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    example. IN NSEC
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    example. IN NSEC
  SECTION ANSWER
    example. 3600 IN NSEC a.example. NS SOA RRSIG NSEC DNSKEY
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    nope.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    nope.example. IN A
ENTRY_END

STEP 7 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    g. IN A
ENTRY_END

STEP 8 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question ede=29
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    g. IN A
ENTRY_END

SCENARIO_END

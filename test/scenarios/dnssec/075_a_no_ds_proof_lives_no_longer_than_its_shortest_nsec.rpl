; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .

SCENARIO_BEGIN a no-DS proof lives no longer than its shortest NSEC, zero included

; The referral's proof of no DS leads with an NSEC of TTL 0 (RFC 2181 §8),
; so the fact that example. is unsigned lives no time at all: a later name
; below it asks the root for the DS again. The 3600 of the NSEC beside it
; does not lengthen it.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN DS
    SECTION AUTHORITY
      . 3600 IN SOA a.root. nobody.invalid. 1 7200 3600 86400 3600
      example. 3600 IN NSEC zz. NS RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 0 IN NSEC zz. NS RRSIG NSEC
      aa. 3600 IN NSEC ab. NS RRSIG NSEC
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example. IN A
    SECTION ANSWER
      mail.example. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 1

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    mail.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    mail.example. IN A
  SECTION ANSWER
    mail.example. 3600 IN A 192.0.2.2
ENTRY_END

STEP 6 CHECK_QUERY_LOG
ENTRY_BEGIN
  SECTION QUERY_LOG
    example. DS 127.0.10.1
ENTRY_END

SCENARIO_END

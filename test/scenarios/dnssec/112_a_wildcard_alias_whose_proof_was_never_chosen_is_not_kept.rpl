; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no

SCENARIO_BEGIN a wildcard alias whose proof was never chosen is not kept

; The root synthesizes a.w. CNAME t. from *.w. (RRSIG labels 1) and
; proves no closer match from an NSEC3 chain at 9000 iterations, past
; what any asker's budget may hash. Unhashed, the proof that is a.w.'s
; own can't be told from the rest, so no alias for a.w. is kept: asked
; for a.w. CNAME, hark asks again and answers with the proof as served.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.w. IN A
    SECTION ANSWER
      a.w. 3600 IN CNAME t.
      a.w. 3600 IN RRSIG CNAME 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION AUTHORITY
      3G0296CSQ440AM918JRUB42G7576P103. 3600 IN NSEC3 1 0 9000 - 3G0296CSQ440AM918JRUB42G7576P105 CNAME RRSIG
      3G0296CSQ440AM918JRUB42G7576P103. 3600 IN RRSIG NSEC3 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      t. IN A
    SECTION ANSWER
      t. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.w. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a.w. IN A
  SECTION ANSWER
    a.w. 3600 IN CNAME t.
    a.w. 3600 IN RRSIG CNAME 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    t. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.w. IN CNAME
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer authority
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a.w. IN CNAME
  SECTION ANSWER
    a.w. 3600 IN CNAME t.
    a.w. 3600 IN RRSIG CNAME 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  SECTION AUTHORITY
    3g0296csq440am918jrub42g7576p103. 3600 IN NSEC3 1 0 9000 - 3G0296CSQ440AM918JRUB42G7576P105 CNAME RRSIG
    3g0296csq440am918jrub42g7576p103. 3600 IN RRSIG NSEC3 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

SCENARIO_END

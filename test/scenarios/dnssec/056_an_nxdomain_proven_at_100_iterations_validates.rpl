; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN an NXDOMAIN proven at 100 iterations validates

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN NS
    SECTION ANSWER
      example. 3600 IN NS ns.example.
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      nx.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      UC55DNUA105VQGLVHE7K5FP4EGV972IP.example. 3600 IN NSEC3 1 0 100 AABB UC55DNUA105VQGLVHE7K5FP4EGV972IQ NS SOA RRSIG DNSKEY NSEC3PARAM
      10E2DHHDNIMRB31ELPTFNIUQMIMRVSB0.example. 3600 IN NSEC3 1 0 100 AABB 10E2DHHDNIMRB31ELPTFNIUQMIMRVSB2 A RRSIG
      HKU9AIVA0TVQQS3EAQ4UA42KTEPR0J5O.example. 3600 IN NSEC3 1 0 100 AABB HKU9AIVA0TVQQS3EAQ4UA42KTEPR0J5Q A RRSIG
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    nx.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    nx.example. IN A
ENTRY_END

SCENARIO_END

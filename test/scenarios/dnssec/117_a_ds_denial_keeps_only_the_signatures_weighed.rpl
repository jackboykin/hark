; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .

SCENARIO_BEGIN a DS denial keeps only the signatures its verifier weighed

; b. is an unsigned delegation. The NSEC denying its DS carries its real
; signature beside one of an unassigned algorithm. When that NSEC later
; denies c. from memory, only the weighed signature travels with it.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b. IN DS
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN NSEC b. SOA NS DNSKEY RRSIG NSEC
      b. 3600 IN NSEC d. NS RRSIG NSEC
      b. 3600 IN RRSIG NSEC 200 1 3600 20990101000000 20200101000000 1 . AAAA
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      b. 3600 IN NS ns.b.
    SECTION ADDITIONAL
      ns.b. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.b. IN A
    SECTION ANSWER
      www.b. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.b. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.b. IN A
  SECTION ANSWER
    www.b. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    c. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question authority ede=29
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    c. IN A
  SECTION AUTHORITY
    . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 3600 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    . 3600 IN NSEC b. SOA NS DNSKEY RRSIG NSEC
    . 3600 IN RRSIG NSEC 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    b. 3600 IN NSEC d. NS RRSIG NSEC
    b. 3600 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN a glued server is reached where the glue says, not where its zone does

; example.com.'s server has moved to 127.0.10.4, and the zone says so, but
; com.'s glue still names 127.0.10.3, where an old copy answers. example.com.
; is reached at the glue before and after the zone's address is held;
; other.com., which names the same server unglued, is reached where the zone
; says. Stale glue is the delegation's to fix.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 172800 IN NS ns.com.
    SECTION ADDITIONAL
      ns.com. 172800 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns1.example.com.
    SECTION ADDITIONAL
      ns1.example.com. 86400 IN A 127.0.10.3
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other.com. IN A
    SECTION AUTHORITY
      other.com. 86400 IN NS ns1.example.com.
  ENTRY_END
RANGE_END

; The old copy.
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns1.example.com. IN A
    SECTION ANSWER
      ns1.example.com. 3600 IN A 127.0.10.4
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns1.example.com. IN AAAA
    SECTION AUTHORITY
      example.com. 3600 IN SOA ns1.example.com. h.example.com. 1 3600 900 604800 3600
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 3600 IN A 192.0.2.98
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example.com. IN A
    SECTION ANSWER
      mail.example.com. 3600 IN A 192.0.2.99
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.4
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example.com. IN A
    SECTION ANSWER
      mail.example.com. 3600 IN A 192.0.2.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.other.com. IN A
    SECTION ANSWER
      www.other.com. 3600 IN A 192.0.2.3
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 3600 IN A 192.0.2.98
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.other.com. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.other.com. IN A
  SECTION ANSWER
    www.other.com. 3600 IN A 192.0.2.3
ENTRY_END

; The zone's address for its server is held now.
STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    mail.example.com. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    mail.example.com. IN A
  SECTION ANSWER
    mail.example.com. 3600 IN A 192.0.2.99
ENTRY_END

SCENARIO_END

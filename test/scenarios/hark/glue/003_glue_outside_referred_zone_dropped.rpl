; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN out-of-bailiwick glue in a referral is dropped, not cached
;
; RFC 1034 §4.3.1 / RFC 2181 §5.4.1 / RFC 8499 (bailiwick): a parent zone
; may ONLY supply glue for names within its own bailiwick. Glue records
; for names outside the parent's authority are unverified hearsay and MUST
; NOT be trusted or cached. A buggy resolver that accepts the stray glue
; opens a cache-injection vector (DNS Kaminsky-class) and can be steered
; to any IP the attacker chooses.
;
; Bug-mode this scenario catches: a resolver that accepts ADDITIONAL
; records regardless of bailiwick would silently cache
; `ns.evil.org. A 127.0.10.99` from .com's referral. Later, when a client
; asks for `evil.org. A`, the resolver would skip the root → org chase
; and either query 127.0.10.99 directly (no responder there → SERVFAIL or
; timeout) or, worse, return the poisoned data as an answer.
;
; Topology
;   root  127.0.10.1   refers com → 127.0.10.2 and org → 127.0.10.5
;   com   127.0.10.2   referral for example.com WITH valid in-bailiwick
;                      glue, PLUS a stray ns.evil.org. A 127.0.10.99 that
;                      a correct resolver must drop on the floor.
;   xcom  127.0.10.3   authoritative for example.com.
;   org   127.0.10.5   refers evil.org → ns.evil.org. with glue at the
;                      *correct* address 127.0.10.6 (in-bailiwick of org).
;   evil  127.0.10.6   authoritative for evil.org.
;
; Note: 127.0.10.99 is intentionally NOT served by any responder. If hark
; wrongly accepted the stray glue, the follow-up STEP 3 query for evil.org
; would be sent there and the test would time out / SERVFAIL.

; ── Root ───────────────────────────────────────────────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      org. IN A
    SECTION AUTHORITY
      org. 86400 IN NS a.org-tld.fake.
    SECTION ADDITIONAL
      a.org-tld.fake. 86400 IN A 127.0.10.5
  ENTRY_END
RANGE_END

; ── .com authority — referral spiced with poisoned glue ─────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.example.com.
    SECTION ADDITIONAL
      ; Legitimate, in-bailiwick of com. — trusted.
      ns.example.com. 86400 IN A 127.0.10.3
      ; Out-of-bailiwick (org is not below com). A correct resolver
      ; discards this; a broken one caches it and poisons evil.org.
      ns.evil.org. 86400 IN A 127.0.10.99
  ENTRY_END
RANGE_END

; ── example.com authority ──────────────────────────────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION ANSWER
      example.com. 3600 IN A 93.184.216.34
  ENTRY_END
RANGE_END

; ── .org authority — clean referral for evil.org. ───────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.5
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      evil.org. IN A
    SECTION AUTHORITY
      evil.org. 86400 IN NS ns.evil.org.
    SECTION ADDITIONAL
      ; The real glue, in-bailiwick of org. The stray glue from com.
      ; pointed at 127.0.10.99 — note this points at 127.0.10.6 instead.
      ns.evil.org. 86400 IN A 127.0.10.6
  ENTRY_END
RANGE_END

; ── evil.org authority ─────────────────────────────────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.6
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      evil.org. IN A
    SECTION ANSWER
      evil.org. 3600 IN A 198.51.100.7
  ENTRY_END
RANGE_END

; ── STEP 1: warm cache with example.com to plant any poisoned glue ─────
STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    example.com. IN A
  SECTION ANSWER
    example.com. 3600 IN A 93.184.216.34
ENTRY_END

; ── STEP 3: now ask evil.org. If the stray glue was cached, hark would
;            query 127.0.10.99 (no responder → timeout/SERVFAIL). A correct
;            resolver chases the org tree and returns 198.51.100.7. ─────
STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    evil.org. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    evil.org. IN A
  SECTION ANSWER
    evil.org. 3600 IN A 198.51.100.7
ENTRY_END

; The evil.org A query MUST land on 127.0.10.6 (the real auth, learned via
; org's in-bailiwick glue) and NEVER on 127.0.10.99 (the poisoned address).
; Presence of the row at .6 plus the successful CHECK_ANSWER above is the
; proof — a resolver that used .99 would have produced SERVFAIL on STEP 4.
STEP 5 CHECK_QUERY_LOG
ENTRY_BEGIN
  SECTION QUERY_LOG
    evil.org. A 127.0.10.6
ENTRY_END

SCENARIO_END

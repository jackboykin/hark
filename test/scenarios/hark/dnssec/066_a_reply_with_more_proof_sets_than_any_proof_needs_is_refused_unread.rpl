; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .

SCENARIO_BEGIN a reply with more proof sets than any proof needs is refused unread

; A denial needs at most a handful of NSEC or NSEC3 sets; this one carries
; 300. A flood is refused as bogus before the first claim: nothing is
; fetched past the answer itself.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION

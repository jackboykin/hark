; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .

SCENARIO_BEGIN a leading signature no key can verify names no signer

; b. is denied by the root, its NSECs signed by it. Ahead of a.'s real
; signature rides one of an unassigned algorithm naming zz.: it could
; never verify, so it cannot pick whose proof the NSEC is.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
      a. 3600 IN RRSIG NSEC 200 1 3600 20990101000000 20200101000000 1 zz. AAAA
      a. 3600 IN NSEC c. A RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    b. IN A
  SECTION AUTHORITY
    . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 3600 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
    a. 3600 IN NSEC c. A RRSIG NSEC
ENTRY_END

SCENARIO_END

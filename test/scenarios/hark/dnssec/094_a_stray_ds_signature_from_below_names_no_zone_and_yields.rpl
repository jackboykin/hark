; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = sub.a.example.

SCENARIO_BEGIN a stray ds signature from below names no zone and yields

; example. delegates sub.a.example. with its DS signed by example. and
; with a stray RRSIG naming a.example., the deepest signer that could
; hold a DS at sub.a.example. example. proves a.example. is no cut, so
; the DS sits in example., and its signature anchors the child.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      a.example. 3600 IN NSEC sub.a.example. A RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      sub.a.example. IN A
    SECTION AUTHORITY
      sub.a.example. 3600 IN NS ns.sub.a.example.
      sub.a.example. 3600 IN DS PLACEHOLDER
      sub.a.example. 3600 IN RRSIG DS 13 3 3600 20500101000000 20200101000000 1 a.example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION ADDITIONAL
      ns.sub.a.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.sub.a.example. IN A
    SECTION ANSWER
      www.sub.a.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.sub.a.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.sub.a.example. IN A
  SECTION ANSWER
    www.sub.a.example. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

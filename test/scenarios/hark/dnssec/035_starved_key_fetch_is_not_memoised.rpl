; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: max-queries = 3

SCENARIO_BEGIN a DNSKEY fetch refused by one client's budget is no verdict for the next client

; The first client spends its three exchanges before its keys are judged;
; its next fetch is refused and it SERVFAILs. dnskey(example) is shared:
; memoising that refusal as bogus for the SERVFAIL window failed every
; name under a TLD for 5 s whenever one asker's budget or orphaning
; starved the TLD's key fetch (live: ~40 .org names in one cold second).
; Nothing the first judged, nothing of it is kept: the second, on a fresh
; budget, needs four exchanges and is stopped by its own limit, never by
; a verdict. What it judged is kept, so the third gets AD.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.example. IN A
    SECTION ANSWER
      a.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.example. IN A
    SECTION ANSWER
      b.example. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=0
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    a.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=0
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    b.example. IN A
ENTRY_END

; The first client, asked again, is tried again: its budget was its own.
STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    a.example. IN A
ENTRY_END

STEP 7 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b.example. IN A
ENTRY_END

STEP 8 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    b.example. IN A
  SECTION ANSWER
    b.example. 3600 IN A 192.0.2.2
ENTRY_END

SCENARIO_END

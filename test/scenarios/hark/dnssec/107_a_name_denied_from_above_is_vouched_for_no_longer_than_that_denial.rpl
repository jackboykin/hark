; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN a name denied from above is vouched for no longer than that denial

; example.'s DS lives a minute, and the verdict on the denial with it, so
; the name below ends with that verdict, not the denial's hour. Past it
; the zone is unsigned and the question is sent.
;
; 3MSE…O1 is example., B39F…PE is b.example., 99JA…05 is *.example.

RANGE_BEGIN 0 3
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 60 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 4 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    SIGN_AS .
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN DS
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 2 7200 3600 86400 3600
      example. 3600 IN NSEC f. NS RRSIG NSEC
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      b.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      3MSEV9USMD4BR9S97V51R2TDVMR9IQO1.example. 3600 IN NSEC3 1 0 0 - 3MSEV9USMD4BR9S97V51R2TDVMR9IQO2 NS SOA RRSIG DNSKEY NSEC3PARAM
      B39F52K2414AIT0PCPFJOSGB4BS25JPD.example. 3600 IN NSEC3 1 0 0 - B39F52K2414AIT0PCPFJOSGB4BS25JPF A RRSIG
      99JAHPQEE6F2BU0N7I5CPSM6PBS6TP04.example. 3600 IN NSEC3 1 0 0 - 99JAHPQEE6F2BU0N7I5CPSM6PBS6TP06 A RRSIG
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.foo.b.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    www.foo.b.example. IN A
  SECTION ANSWER
ENTRY_END

STEP 3 CHECK_MAX_QUERIES 4

STEP 4 TIME_PASSES ELAPSE 100

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.foo.b.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA NXDOMAIN
  SECTION QUESTION
    www.foo.b.example. IN A
  SECTION ANSWER
ENTRY_END

STEP 7 CHECK_QUERY_LOG
ENTRY_BEGIN
  SECTION QUERY_LOG
    www.foo.b.example. A 127.0.10.2
ENTRY_END

SCENARIO_END

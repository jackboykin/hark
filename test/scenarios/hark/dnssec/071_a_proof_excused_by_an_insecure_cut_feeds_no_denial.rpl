; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN a proof excused by a hidden insecure cut must not feed the aggressive nsec index

; b.example. is an unsigned child on example.'s servers (hidden cut).
; A spoofed NXDOMAIN for x.b.example. carries example.'s genuinely
; signed SOA and a forged NSEC (junk signature naming example.) spanning
; the whole zone. The forged NSEC is excused by the cut; it must not
; then deny www.example., which exists, with AD.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      b.example. 3600 IN NSEC c.example. NS RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      x.b.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      example. 3600 IN NSEC zz.example. NS SOA RRSIG NSEC DNSKEY
      example. 3600 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.9
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    x.b.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA NXDOMAIN
  SECTION QUESTION
    x.b.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.9
ENTRY_END

SCENARIO_END

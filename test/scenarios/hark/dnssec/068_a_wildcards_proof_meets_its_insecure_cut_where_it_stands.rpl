; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN a wildcard's proof meets its insecure cut where it stands, not where the chain ends

; example.'s server also serves child.example., unsigned, with no DS: an
; insecure cut the walk never saw. a.child.example. comes expanded from
; *.child.example. into an alias out of both zones, b.other., under
; signatures naming example. that prove nothing, and a proof of no closer
; match signed alike. Below the insecure cut signatures don't matter
; (RFC 4035 §5): the alias meets that cut above its own owner, and so
; must its proof. The chain's end, outside the zone, has no cut to find.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.other. IN A
    SECTION ANSWER
      b.other. 3600 IN A 192.0.2.2
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN NS
    SECTION ANSWER
      example. 3600 IN NS ns.example.
  ENTRY_END

  ; The parent's word on the cut: NSEC without the DS bit.
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      child.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      child.example. 3600 IN NSEC z.example. NS RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.child.example. IN A
    SECTION ANSWER
      a.child.example. 3600 IN CNAME b.other.
      a.child.example. 3600 IN RRSIG CNAME 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION AUTHORITY
      *.child.example. 3600 IN NSEC b.child.example. CNAME RRSIG NSEC
      *.child.example. 3600 IN RRSIG NSEC 13 3 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.child.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a.child.example. IN A
  SECTION ANSWER
    a.child.example. 3600 IN CNAME b.other.
    b.other. 3600 IN A 192.0.2.2
ENTRY_END

SCENARIO_END

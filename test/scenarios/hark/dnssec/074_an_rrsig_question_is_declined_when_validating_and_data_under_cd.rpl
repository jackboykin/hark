; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = net.

SCENARIO_BEGIN an rrsig question is declined when validating and answered as data under cd

; RRSIGs are never signed (RFC 4035 §2.2), so an answer of them can't be
; validated. With CD clear the question is declined up front, NOTIMP with
; EDE 21, asking nobody. With CD set they are data, never AD, an RRSIG
; over an RRSIG kept once (RFC 2181 §5): in a signed zone, and at the end
; of a signed DNAME's chain, whose links prove nothing about the
; signatures there.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      net. IN A
    SECTION AUTHORITY
      net. 3600 IN NS ns.net.
      net. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.net. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.net. IN RRSIG
    SECTION ANSWER
      www.net. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 net. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN RRSIG
    SECTION ANSWER
      www.example. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      www.example. 3600 IN RRSIG RRSIG 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.sub.example. IN RRSIG
    SECTION ANSWER
      sub.example. 3600 IN DNAME dst.example.
      www.sub.example. 3600 IN CNAME www.dst.example.
      www.dst.example. 3600 IN RRSIG A 13 3 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.dst.example. IN RRSIG
    SECTION ANSWER
      www.dst.example. 3600 IN RRSIG A 13 3 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.out.example. IN RRSIG
    SECTION ANSWER
      out.example. 3600 IN DNAME net.
      www.out.example. 3600 IN CNAME www.net.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.b.example. IN RRSIG
    SECTION ANSWER
      b.example. 3600 IN DNAME example.
      b.example. 3600 IN RRSIG DNAME 200 2 3600 20990101000000 20200101000000 1 evil. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      b.b.example. 3600 IN CNAME b.example.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      x.example. IN A
    SECTION ANSWER
      x.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      example. 3600 IN NSEC zzz.example. NS SOA RRSIG NSEC DNSKEY
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN RRSIG
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer ede=21
  REPLY QR RD RA NOTIMP
  SECTION QUESTION
    www.example. IN RRSIG
ENTRY_END

STEP 3 CHECK_MAX_QUERIES 0

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    www.example. IN RRSIG
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    www.example. IN RRSIG
  SECTION ANSWER
    www.example. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    www.example. 3600 IN RRSIG RRSIG 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

; Asked again: nothing judged, nothing refetched.
STEP 6 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    www.example. IN RRSIG
ENTRY_END

STEP 7 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    www.example. IN RRSIG
  SECTION ANSWER
    www.example. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    www.example. 3600 IN RRSIG RRSIG 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 8 CHECK_MAX_QUERIES 4

STEP 9 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    www.sub.example. IN RRSIG
ENTRY_END

STEP 10 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    www.sub.example. IN RRSIG
ENTRY_END

; A secure DNAME into another zone: the link's AD doesn't cover the
; signatures its chain ends at there.
STEP 11 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    www.out.example. IN RRSIG
ENTRY_END

STEP 12 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    www.out.example. IN RRSIG
ENTRY_END

; A chain back to the DNAME it passed ends at that DNAME's signatures,
; kept once and bound: the stored DNAME later serves with AD beside its
; own signature only, no second copy and no stranger's.
STEP 13 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    b.b.example. IN RRSIG
ENTRY_END

STEP 14 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA CD NOERROR
  SECTION QUESTION
    b.b.example. IN RRSIG
  SECTION ANSWER
    b.example. 3600 IN DNAME example.
    b.example. 3600 IN RRSIG DNAME 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    b.b.example. 3600 IN CNAME b.example.
ENTRY_END

STEP 15 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    x.b.example. IN A
ENTRY_END

STEP 16 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    x.b.example. IN A
  SECTION ANSWER
    b.example. 3600 IN DNAME example.
    b.example. 3600 IN RRSIG DNAME 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    x.b.example. 3600 IN CNAME x.example.
    x.example. 3600 IN A 192.0.2.1
    x.example. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

SCENARIO_END

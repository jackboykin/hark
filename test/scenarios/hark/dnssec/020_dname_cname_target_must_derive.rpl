; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .

SCENARIO_BEGIN a CNAME below a signed DNAME is its derivation, whatever the server sent

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.doc.example. IN A
    SECTION ANSWER
      doc.example. 3600 IN DNAME archive.example.
      www.doc.example. 3600 IN CNAME www.evil.example.
      www.evil.example. 3600 IN A 192.0.2.66
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.archive.example. IN A
    SECTION ANSWER
      www.archive.example. 3600 IN A 192.0.2.9
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.doc.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.doc.example. IN A
  SECTION ANSWER
    doc.example. 3600 IN DNAME archive.example.
    www.doc.example. 3600 IN CNAME www.archive.example.
    www.archive.example. 3600 IN A 192.0.2.9
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: sig-validity = 100

SCENARIO_BEGIN a denial lives no longer than its signatures

; Every record has an hour, every signature 100 s. A NODATA, an NXDOMAIN
; and the sibling it proves (RFC 8198) live no longer than their proof
; (RFC 4035 5.3.3), live or from memory, and a cached denial keeps the
; SOA's signature. Past 100 s each is asked for again.
;
; a. and c. exist: a. NSEC c. covers b. and b2., . NSEC a. the wildcard.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
      a. 3600 IN NSEC c. A RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a. IN AAAA
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      a. 3600 IN NSEC c. A RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority ttl
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    a. IN AAAA
  SECTION AUTHORITY
    . 100 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 100 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 100 IN NSEC c. A RRSIG NSEC
    a. 100 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority ttl
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    b. IN A
  SECTION AUTHORITY
    . 100 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 100 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    . 100 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
    . 100 IN RRSIG NSEC 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 100 IN NSEC c. A RRSIG NSEC
    a. 100 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b2. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority ttl ede=29
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    b2. IN A
  SECTION AUTHORITY
    . 100 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 100 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    . 100 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
    . 100 IN RRSIG NSEC 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 100 IN NSEC c. A RRSIG NSEC
    a. 100 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 7 TIME_PASSES ELAPSE 60

STEP 8 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 9 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority ttl
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    a. IN AAAA
  SECTION AUTHORITY
    . 40 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 40 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 40 IN NSEC c. A RRSIG NSEC
    a. 40 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 10 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 11 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority ttl
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    b. IN A
  SECTION AUTHORITY
    . 40 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 40 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    . 40 IN NSEC a. SOA NS DNSKEY RRSIG NSEC
    . 40 IN RRSIG NSEC 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 40 IN NSEC c. A RRSIG NSEC
    a. 40 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

STEP 12 TIME_PASSES ELAPSE 41

STEP 13 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 14 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 15 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b2. IN A
ENTRY_END

; b2. is never asked: b.'s NSEC proved it.

STEP 16 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 17 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    . IN DNSKEY
ENTRY_END

STEP 18 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    b. IN A
ENTRY_END

STEP 19 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 20 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    . IN DNSKEY
ENTRY_END

STEP 21 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    b. IN A
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a CNAME signed only with an unvalidatable algorithm is bogus

; 012's shape, but the CNAME is signed with algorithm 3 (DSA), unimplemented
; here. The zone is known secure (its DS carries a supported algorithm), so
; real supported signatures existed and were stripped: serving this would let
; an injector swap the RRSIGs on any RRset for one unsupported-algorithm
; signature and get forged data served instead of rejected. Unbound reaches
; the same verdict — its only insecure escape is the zone-level DS-algorithm
; check (RFC 4035 §5.2), which hark applies at the delegation; scenario 017
; covers that side (the genuinely all-unsupported zone must NOT land here).
;
; Expected: SERVFAIL.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      child.example. IN DS
    SECTION ANSWER
      child.example. 3600 IN DS PLACEHOLDER
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN CNAME target.child.example.
      ; Algorithm 3 = DSA/SHA1, never implemented here. Declaring the RRSIG
      ; keeps the harness from adding a validatable one over the same RRset.
      www.example. 3600 IN RRSIG CNAME 3 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      target.child.example. 3600 IN A 192.0.2.7
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

SCENARIO_END

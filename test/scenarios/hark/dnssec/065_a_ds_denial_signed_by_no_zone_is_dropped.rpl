; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = c.x.example.

SCENARIO_BEGIN a DS denial signed by a name proven no zone is bogus, and its bytes go

; example.'s referral to c.x.example. first carries a forged denial of its
; DS, signed in the name of x.example., which example.'s own NSEC shows is
; no delegation. That absence is a fact, not a failed fetch: the denial
; is bogus, and its bytes end with the verdict, their TTL being the
; forger's (RFC 4035 §4.7). Once the window lapses, the real DS is asked
; for and the child validates.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      x.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      x.example. 3600 IN NSEC y.example. A RRSIG NSEC
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      c.x.example. IN A
    SECTION AUTHORITY
      c.x.example. 3600 IN NS ns.c.x.example.
      c.x.example. 3600 IN NSEC d.x.example. NS RRSIG NSEC
      c.x.example. 3600 IN RRSIG NSEC 13 3 3600 20990101000000 20200101000000 1 x.example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION ADDITIONAL
      ns.c.x.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      c.x.example. IN A
    SECTION AUTHORITY
      c.x.example. 3600 IN NS ns.c.x.example.
      c.x.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.c.x.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.c.x.example. IN A
    SECTION ANSWER
      www.c.x.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 10

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.c.x.example. IN A
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN a chain back to the DNAME it passed answers with it once

; Asked for b.b.example's DNAME, the chain passes b.example's DNAME to
; b.example itself, where that DNAME is the answer. It is one set, kept
; once: two copies would be judged as one set of two records under a
; signature over one, and fail.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.b.example. IN DNAME
    SECTION ANSWER
      b.example. 3600 IN DNAME example.
      b.b.example. 3600 IN CNAME b.example.
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b.b.example. IN DNAME
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    b.b.example. IN DNAME
  SECTION ANSWER
    b.example. 3600 IN DNAME example.
    b.example. 3600 IN RRSIG DNAME 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    b.b.example. 3600 IN CNAME b.example.
ENTRY_END

SCENARIO_END

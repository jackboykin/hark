; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = other.

SCENARIO_BEGIN a cname proven bogus ends in the alias taken from it

; A reply that starts with a CNAME also stores that CNAME as an alias.
;
; www.example's first reply has no signatures, so its CNAME is bogus. The
; A question drops it, and the alias with it. Later questions go upstream
; and get the signed answer.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.example.
      example. 86400 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 86400 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other. IN A
    SECTION AUTHORITY
      other. 86400 IN NS ns.other.
      other. 86400 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.other. 86400 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      www.example. 3600 IN NSEC z.example. CNAME RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query unsigned
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 300 IN CNAME edge.other.
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      www.example. 3600 IN NSEC z.example. CNAME RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 300 IN CNAME edge.other.
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      edge.other. IN A
    SECTION ANSWER
      edge.other. 60 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      edge.other. IN AAAA
    SECTION ANSWER
      edge.other. 60 IN AAAA 2001:db8::1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=6
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 10

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN CNAME
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN CNAME
  SECTION ANSWER
    www.example. 300 IN CNAME edge.other.
ENTRY_END

STEP 6 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 7 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 300 IN CNAME edge.other.
    edge.other. 60 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

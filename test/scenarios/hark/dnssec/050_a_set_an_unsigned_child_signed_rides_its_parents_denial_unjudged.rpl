; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a set an unsigned child signed rides its parent's denial unjudged

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN NS
    SECTION ANSWER
      example. 3600 IN NS ns.example.
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    SIGN_AS example.
    REPLY QR AA NOERROR
    SECTION QUESTION
      child.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      child.example. 3600 IN NSEC z.example. NS RRSIG NSEC
  ENTRY_END

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      v.example. IN AAAA
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      v.example. 3600 IN NSEC z.example. A RRSIG NSEC
      a.child.example. 3600 IN NSEC b.child.example. A RRSIG NSEC
  ENTRY_END
RANGE_END

; A set the unsigned child signed rides a denial its parent signed. No
; proof owes it, so it is dropped unjudged.
STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    v.example. IN AAAA
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question authority
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    v.example. IN AAAA
  SECTION AUTHORITY
    example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
    v.example. 3600 IN NSEC z.example. A RRSIG NSEC
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = other.

SCENARIO_BEGIN a held signed cname answers the next type with its own verdict

; www.example is a signed CNAME into another signed zone, like a CDN name.
; The A question stores the CNAME. The AAAA question reuses it, validated
; on its own, and gets AD. The TTL shows the reuse: 290, not a fresh 300.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.example.
      example. 86400 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 86400 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other. IN A
    SECTION AUTHORITY
      other. 86400 IN NS ns.other.
      other. 86400 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.other. 86400 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ; The server answers every type at www.example with the CNAME.
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 300 IN CNAME edge.other.
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      edge.other. IN A
    SECTION ANSWER
      edge.other. 60 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      edge.other. IN AAAA
    SECTION ANSWER
      edge.other. 60 IN AAAA 2001:db8::1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode answer question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 300 IN CNAME edge.other.
    edge.other. 60 IN A 192.0.2.1
ENTRY_END

STEP 4 TIME_PASSES ELAPSE 10

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN AAAA
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode answer question ttl
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN AAAA
  SECTION ANSWER
    www.example. 290 IN CNAME edge.other.
    edge.other. 60 IN AAAA 2001:db8::1
ENTRY_END

SCENARIO_END

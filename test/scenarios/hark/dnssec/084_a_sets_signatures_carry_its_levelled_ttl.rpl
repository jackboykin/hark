; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN a set's signatures carry its levelled TTL

; The address set at the end of the chain arrives with TTLs of 300 and 60
; and is one at 60 (RFC 2181 §5.2). Its signature arrives at 300, after
; the other set's: left there, hark would send a signature whose TTL is
; not its set's (RFC 4034 §3), a mismatch of hark's own making. Another
; signer's signature at TTL 0 is no part of the set: dropped, it lowers
; nothing.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      alias.example. IN A
    SECTION ANSWER
      alias.example. 300 IN CNAME www.example.
      www.example. 300 IN A 192.0.2.1
      www.example. 60 IN A 192.0.2.2
      www.example. 0 IN RRSIG A 200 2 300 20990101000000 20200101000000 1 other. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    alias.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    alias.example. IN A
  SECTION ANSWER
    alias.example. 300 IN CNAME www.example.
    alias.example. 300 IN RRSIG CNAME 13 2 300 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    www.example. 60 IN A 192.0.2.1
    www.example. 60 IN A 192.0.2.2
    www.example. 60 IN RRSIG A 13 2 300 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENTRY_END

SCENARIO_END

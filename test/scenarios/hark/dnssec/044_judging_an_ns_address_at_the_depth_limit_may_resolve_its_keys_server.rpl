; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = d.

SCENARIO_BEGIN judging an NS address at the depth limit may resolve its keys' server

; a., b. and c. are each served by a name in the next zone, unglued, so
; www.a. needs three NS-address resolutions deep: host.d. is resolved at
; the depth limit. d. is signed and delegated to ns.w. with sibling glue
; of TTL 0, which serves the walk that received it and nothing after. So
; judging host.d.'s address fetches d.'s DNSKEY from ns.w., whose address
; must now be resolved itself. Depth counts an address's own lookups:
; the judgement sits at the address's level, not below it, so ns.w. is
; still within the limit and www.a. resolves.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      a. IN A
    SECTION AUTHORITY
      a. 3600 IN NS ns.b.
      a. 3600 IN NSEC b. NS RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      b. 3600 IN NS ns.c.
      b. 3600 IN NSEC c. NS RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      c. IN A
    SECTION AUTHORITY
      c. 3600 IN NS host.d.
      c. 3600 IN NSEC d. NS RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      d. IN A
    SECTION AUTHORITY
      d. 3600 IN NS ns.w.
      d. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.w. 0 IN A 127.0.10.4
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      w. IN A
    SECTION AUTHORITY
      w. 3600 IN NS ns1.w.
      w. 3600 IN NSEC zz. NS RRSIG NSEC
    SECTION ADDITIONAL
      ns1.w. 3600 IN A 127.0.10.5
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.a. IN A
    SECTION ANSWER
      www.a. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.b. IN A
    SECTION ANSWER
      ns.b. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.6
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.c. IN A
    SECTION ANSWER
      ns.c. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.4
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      host.d. IN A
    SECTION ANSWER
      host.d. 3600 IN A 127.0.10.6
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.5
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.w. IN A
    SECTION ANSWER
      ns.w. 3600 IN A 127.0.10.4
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.a. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.a. IN A
  SECTION ANSWER
    www.a. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

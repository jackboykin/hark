; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: max-queries = 6

SCENARIO_BEGIN a probe the query budget cut short leaves no refusal behind

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query unsigned
    REPLY QR AA NOERROR
    SECTION QUESTION
      uni.edu.example. IN DS
    SECTION AUTHORITY
      edu.example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query unsigned
    REPLY QR NOERROR
    SECTION QUESTION
      uni.edu.example. IN A
    SECTION AUTHORITY
      uni.edu.example. 3600 IN NS ns.uni.edu.example.
    SECTION ADDITIONAL
      ns.uni.edu.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      edu.example. IN DS
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      edu.example. 3600 IN NSEC z.example. NS RRSIG NSEC
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query unsigned
    REPLY QR AA NOERROR
    SECTION QUESTION
      uni.edu.example. IN A
    SECTION ANSWER
      uni.edu.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.uni.edu.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.uni.edu.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www2.uni.edu.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www2.uni.edu.example. IN A
ENTRY_END

STEP 5 CHECK_MAX_QUERIES 8

SCENARIO_END

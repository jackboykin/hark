; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .

SCENARIO_BEGIN a denial judged bogus places no cut: the name is probed again

; The root denies b. with no proof. Judged bogus, the denial places no
; cut past the walk that drew it.

RANGE_BEGIN 0 1000
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      b. IN A
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.foo.b. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH question ede=6
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.foo.b. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 600

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    mail.other.b. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH question ede=6
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    mail.other.b. IN A
ENTRY_END

STEP 6 CHECK_QUERY_LOG
ENTRY_BEGIN
  MATCH order
  SECTION QUERY_LOG
    b. A 127.0.10.1
    www.foo.b. A 127.0.10.1
    b. A 127.0.10.1
    mail.other.b. A 127.0.10.1
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: minimal-responses = no

SCENARIO_BEGIN a secure reply's authority is what its verdict judged, its additional nothing

; Under AD, authority holds only what the verdict judged (RFC 4035
; §3.2.3): a negative keeps its proof, a wildcard's expansion its proof of
; no closer match, a plain answer nothing. Nothing judges the additional
; section, nor a signature over no set the reply holds.
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a. IN A
    SECTION ANSWER
      a. 3600 IN A 192.0.2.1
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    WILDCARD *.
    REPLY QR AA NOERROR
    SECTION QUESTION
      w. IN A
    SECTION ANSWER
      w. 3600 IN A 192.0.2.2
    SECTION AUTHORITY
      c. 3600 IN NSEC zz. A RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a. IN TXT
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      a. 3600 IN NSEC c. A RRSIG NSEC
      zz. 3600 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      . 3600 IN NS ns9.
      . 3600 IN RRSIG NS 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    SECTION ADDITIONAL
      ns9. 3600 IN A 192.0.2.9
      ns9. 3600 IN RRSIG A 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer authority
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    a. IN A
  SECTION ANSWER
    a. 3600 IN A 192.0.2.1
  SECTION AUTHORITY
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    w. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer authority
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    w. IN A
  SECTION ANSWER
    w. 3600 IN A 192.0.2.2
  SECTION AUTHORITY
    c. 3600 IN NSEC zz. A RRSIG NSEC
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN TXT
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question answer authority additional
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    a. IN TXT
  SECTION ANSWER
  SECTION AUTHORITY
    . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    . 3600 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    a. 3600 IN NSEC c. A RRSIG NSEC
    a. 3600 IN RRSIG NSEC 13 1 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  SECTION ADDITIONAL
ENTRY_END

SCENARIO_END

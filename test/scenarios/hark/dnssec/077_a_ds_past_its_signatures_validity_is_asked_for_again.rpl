; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: sig-validity = 100

SCENARIO_BEGIN a DS past its signatures' validity is asked for again

; example. is delegated with a DS, other. with a denial of one. Every
; record has an hour, every signature 100 s. Each DS answer, judged on
; the way to www, lives no longer than its signatures (RFC 4035 5.3.3):
; asked for past them, both are fetched again. They are asked for
; directly, since any answer below waits first on the root's keys, which
; run out with them.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN DS
    SECTION ANSWER
      example. 3600 IN DS PLACEHOLDER
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      other. IN DS
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      other. 3600 IN NSEC zz. NS RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other. IN A
    SECTION AUTHORITY
      other. 3600 IN NS ns.other.
      other. 3600 IN NSEC zz. NS RRSIG NSEC
    SECTION ADDITIONAL
      ns.other. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.other. IN A
    SECTION ANSWER
      www.other. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.other. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 101

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    example. IN DS
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    other. IN DS
ENTRY_END

STEP 6 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example. IN A
ENTRY_END

STEP 7 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 8 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example. IN DNSKEY
ENTRY_END

STEP 9 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    . IN DNSKEY
ENTRY_END

STEP 10 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    other. IN A
ENTRY_END

STEP 11 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    www.other. IN A
ENTRY_END

STEP 12 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example. IN DS
ENTRY_END

STEP 13 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    . IN DNSKEY
ENTRY_END

STEP 14 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    other. IN DS
ENTRY_END

STEP 15 CHECK_MAX_QUERIES 9

SCENARIO_END

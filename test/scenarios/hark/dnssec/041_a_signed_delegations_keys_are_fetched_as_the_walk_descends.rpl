; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = sub.example.

SCENARIO_BEGIN a signed delegation's keys are fetched as the walk descends

; Every signed referral on the way down says its zone's keys will prove
; whatever lies below, so they leave with the next step of the walk
; instead of after the answer lands: example.'s DNSKEY goes out beside the
; probe for sub.example, sub.example.'s beside the question itself. Six
; exchanges either way; the chain of trust stops being a round trip per
; level after the answer.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      sub.example. IN A
    SECTION AUTHORITY
      sub.example. 3600 IN NS ns.sub.example.
      sub.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.sub.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.sub.example. IN A
    SECTION ANSWER
      www.sub.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.sub.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.sub.example. IN A
  SECTION ANSWER
    www.sub.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example. IN A
ENTRY_END

STEP 4 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    sub.example. IN A
ENTRY_END

STEP 5 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example. IN DNSKEY
ENTRY_END

STEP 6 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    . IN DNSKEY
ENTRY_END

STEP 7 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    www.sub.example. IN A
ENTRY_END

STEP 8 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    sub.example. IN DNSKEY
ENTRY_END

STEP 9 CHECK_MAX_QUERIES 6
SCENARIO_END

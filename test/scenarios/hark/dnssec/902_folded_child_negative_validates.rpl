; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a negative for a folded child, signed by the parent, gets AD

; The companion of 901 for negatives. hark holds child.example.'s NS and DS
; when the operator folds the child back into example.; the same server now
; answers for the parent. Its NXDOMAIN is signed by example., a signer above
; the tracked cut, and its NSECs cover the name and the wildcard. Judged
; against the signer it is a complete proof: NXDOMAIN with AD.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      child.example. IN A
    SECTION AUTHORITY
      child.example. 3600 IN NS ns.child.example.
      child.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.child.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      www.child.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      example. 3600 IN NSEC c.example. SOA NS DNSKEY RRSIG NSEC
      c.example. 3600 IN NSEC x.example. A RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

SCENARIO_END

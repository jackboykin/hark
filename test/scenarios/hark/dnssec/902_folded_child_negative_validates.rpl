; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a negative for a folded child, signed by the parent, gets AD

; The companion of 901 for negatives. hark holds child.example.'s NS and DS
; when the operator folds the child back into example.; the same server now
; answers for the parent. Its NXDOMAIN is signed by example., a signer above
; the tracked cut, and its NSECs cover the name and the wildcard. Judged
; against the signer it is a complete proof: NXDOMAIN with AD, kept for
; the SOA's negative TTL like any other denial. The parent's chain runs
; through x.child.example, which it now serves.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      child.example. IN A
    SECTION AUTHORITY
      child.example. 3600 IN NS ns.child.example.
      child.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.child.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.3

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      www.child.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 2 7200 3600 86400 3600
      example. 3600 IN NSEC c.example. SOA NS DNSKEY RRSIG NSEC
      c.example. 3600 IN NSEC x.child.example. A RRSIG NSEC
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.3

  ; An RRset is another matter: the parent's signature over a name below
  ; the tracked cut claims across it (RFC 4035 §5.3.1), and the CNAME
  ; kept as its own fact is still the child's zone's.
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    SIGN_AS example.
    REPLY QR AA NOERROR
    SECTION QUESTION
      x.child.example. IN A
    SECTION ANSWER
      x.child.example. 3600 IN CNAME www.example.
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    x.child.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    x.child.example. IN A
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    x.child.example. IN CNAME
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    x.child.example. IN CNAME
ENTRY_END

; From memory: the server that denied it no longer answers.
STEP 7 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

STEP 8 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

SCENARIO_END

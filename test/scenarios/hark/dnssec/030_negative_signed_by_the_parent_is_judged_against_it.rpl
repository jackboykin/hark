; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a negative under a secure child signed only by the parent is bogus

; child.example. is a secure delegation. Its server answers NXDOMAIN with
; example.'s genuine signed SOA and NSECs: material anyone gets by asking
; the parent. The signer verifies but sits above the tracked cut, and that
; used to skip the proof entirely. The proof must be judged against the
; signer: the parent's NSEC at child.example. carries NS, so it proves
; nothing below the cut (RFC 6840 §4.1).

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      child.example. IN A
    SECTION AUTHORITY
      child.example. 3600 IN NS ns.child.example.
      child.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.child.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    SIGN_AS example.
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      www.child.example. IN A
    SECTION AUTHORITY
      example. 3600 IN SOA ns.example. nobody.invalid. 1 7200 3600 86400 3600
      example. 3600 IN NSEC child.example. SOA NS DNSKEY RRSIG NSEC
      child.example. 3600 IN NSEC d.example. NS DS RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.child.example. IN A
ENTRY_END

SCENARIO_END

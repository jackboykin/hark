; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = other.

SCENARIO_BEGIN a chain that leaves the zone keeps only its zone's proofs

; One server for example. and other. expands `*.example. CNAME` into
; other. and denies the target there: example.'s no-closer-match proof
; beside other.'s SOA and NSEC, the final query cycle's (RFC 6604 §3).
; hark drops that cycle's rcode for the alias, and must drop its records
; with it: kept, they were checked against example.'s keys and turned a
; secure chain bogus. hark asks other. itself; AD over both.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other. IN A
    SECTION AUTHORITY
      other. 3600 IN NS ns.other.
      other. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.other. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    WILDCARD *.example.
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      foo.example. IN A
    SECTION ANSWER
      foo.example. 3600 IN CNAME foo.other.
    SECTION AUTHORITY
      *.example. 3600 IN NSEC example. CNAME RRSIG NSEC
      other. 3600 IN SOA ns.other. nobody.invalid. 1 7200 3600 86400 3600
      other. 3600 IN NSEC z.other. SOA NS DNSKEY RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NXDOMAIN
    SECTION QUESTION
      foo.other. IN A
    SECTION AUTHORITY
      other. 3600 IN SOA ns.other. nobody.invalid. 1 7200 3600 86400 3600
      other. 3600 IN NSEC z.other. SOA NS DNSKEY RRSIG NSEC
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    foo.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA AD NXDOMAIN
  SECTION QUESTION
    foo.example. IN A
  SECTION ANSWER
    foo.example. 3600 IN CNAME foo.other.
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = uk
; hark: dnssec-zone = co.uk

SCENARIO_BEGIN a no-DS proof signed by a zone the walk never saw as a cut

; co.uk is a signed zone served by uk's own servers: the probe for it gets
; an authoritative NODATA, not a referral, so the walk keeps uk as the cut
; above bbc.co.uk. The referral's NSEC is co.uk's. The proof must be judged
; under the keys of whatever signed it, not the walked parent's.
; Live shape: bbc.co.uk, amazon.co.uk, www.gov.uk (2026-09-18).

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      uk. IN A
    SECTION AUTHORITY
      uk. 3600 IN NS ns.uk.
      uk. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.uk. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      co.uk. IN A
    SECTION AUTHORITY
      co.uk. 3600 IN SOA ns.uk. hostmaster.uk. 1 7200 3600 86400 3600
      co.uk. 3600 IN NSEC zzz.co.uk. NS SOA RRSIG NSEC DNSKEY
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      co.uk. IN DS
    SECTION ANSWER
      co.uk. 3600 IN DS PLACEHOLDER
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      bbc.co.uk. IN A
    SECTION AUTHORITY
      bbc.co.uk. 3600 IN NS ns.bbc.co.uk.
      bbc.co.uk. 3600 IN NSEC bbd.co.uk. NS RRSIG NSEC
    SECTION ADDITIONAL
      ns.bbc.co.uk. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.bbc.co.uk. IN A
    SECTION ANSWER
      www.bbc.co.uk. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.bbc.co.uk. IN A
ENTRY_END

; Insecure, served without AD.
STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.bbc.co.uk. IN A
  SECTION ANSWER
    www.bbc.co.uk. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

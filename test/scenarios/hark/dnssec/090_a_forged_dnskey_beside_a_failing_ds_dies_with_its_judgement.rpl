; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; hark: dnssec-zone = .
; hark: dnssec-zone = example.
; hark: dnssec-zone = child.example.

SCENARIO_BEGIN a forged DNSKEY beside a failing DS dies with its judgement

; Through step 2 example.'s DNSKEY query is lost, so ds(child.example.)
; fails on an input, and a forger answers child.example. DNSKEY with a key
; of its own, unsigned, TTL 86400. The keys fetched alongside the proof
; wait for a verdict that never comes, and bytes reach the store only with
; one: once the forger is gone they are asked for again, and the zone
; validates. Each step asks a fresh name so no per-question failure memo
; confounds.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN DNSKEY
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      child.example. IN A
    SECTION AUTHORITY
      child.example. 3600 IN NS ns.child.example.
      child.example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.child.example. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query unsigned
    REPLY QR AA NOERROR
    SECTION QUESTION
      child.example. IN DNSKEY
    SECTION ANSWER
      child.example. 86400 IN DNSKEY 256 3 13 D+/ABe/kF5u5AXMdT5yylsEquKW0b3E2cL1sWiKDhgn1Q8mnPTOFdeBk8gVMAXq2HSZ+zkhHHtccpA2gCwMRhw==
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.child.example. IN A
    SECTION ANSWER
      a.child.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.child.example. IN A
    SECTION ANSWER
      b.child.example. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a.child.example. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 10

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b.child.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags rcode question
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    b.child.example. IN A
ENTRY_END

SCENARIO_END

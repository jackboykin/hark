; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN control for 009 — a bad signature naming the cut zone SERVFAILs

; The control that makes 009 mean something. Both scenarios present a forged
; answer for `www.example.` inside a proven-secure delegation, and both must
; SERVFAIL — but for different reasons, and a suite that cannot tell them
; apart would not notice the cross-cut check being replaced by something
; softer.
;
;   009  signer = `.`         rejected by the zone-cut binding, BEFORE any
;                             crypto: the signature is real and verifies, and
;                             is refused anyway because `.` is above the cut.
;   010  signer = `example.`  passes the zone-cut binding and must then die in
;                             the crypto path: key_tag 1 matches no DNSKEY in
;                             example.'s randomly generated set.
;
; So 010 is the one that proves hark still fetches `example. DNSKEY` and
; judges the signature. If the cut binding ever swallowed this case too, 010
; would still pass while silently testing nothing — hence the query-log
; assertion below, which pins the DNSKEY fetch that 009 must NOT make.
;
; Topology
;   root     127.0.10.1   delegates example. with a DS
;   example  127.0.10.2   answers with an orphan RRSIG signed as `example.`

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.66
      ; Orphan RRSIG: correct signer for the cut, key_tag 1 matches nothing.
      ; The harness leaves a hand-declared RRSIG alone, so this reaches hark
      ; verbatim.
      www.example. 3600 IN RRSIG A 13 2 3600 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 3 CHECK_QUERY_LOG
ENTRY_BEGIN
  ; The discriminator against 009: hark got far enough to ask the child for
  ; its keys. 009 never reaches this query.
  SECTION QUERY_LOG
    example. DNSKEY 127.0.10.2
ENTRY_END

SCENARIO_END

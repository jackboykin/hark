; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN a probe with nobody to ask is not remembered

; example's only server is ns.other, whose address is refused until step 6.
; The first question's probe at b.example has nobody to ask: no evidence
; against anyone, so nothing is remembered. Once the address resolves, the
; second question probes b.example before asking in full.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.other.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      other. IN A
    SECTION AUTHORITY
      other. 86400 IN NS a.nic.fake.
    SECTION ADDITIONAL
      a.nic.fake. 86400 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 5
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      other. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 6 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.other. IN A
    SECTION ANSWER
      ns.other. 300 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.other. IN AAAA
    SECTION AUTHORITY
      other. 300 IN SOA a.nic.fake. host.other. 1 3600 600 86400 300
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b.example. IN A
    SECTION AUTHORITY
      example. 300 IN SOA ns.other. host.example. 1 3600 600 86400 300
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      h2.b.example. IN A
    SECTION ANSWER
      h2.b.example. 300 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    h1.b.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    h1.b.example. IN A
ENTRY_END

STEP 6 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    h2.b.example. IN A
ENTRY_END

STEP 7 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    h2.b.example. IN A
  SECTION ANSWER
    h2.b.example. 300 IN A 192.0.2.2
ENTRY_END

STEP 8 CHECK_QUERY_LOG
ENTRY_BEGIN
  MATCH order
  SECTION QUERY_LOG
    b.example. A 127.0.10.2
    h2.b.example. A 127.0.10.2
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: min-ttl = 300
; hark: serve-stale-ttl = 3600
; hark: client-timeout = 2
; hark: qname-minimisation = no

SCENARIO_BEGIN min-ttl floors a 60 s record to 300 s; its stale window and hold follow the floor

; The record's own TTL is 60, so a window computed from it would end at
; 3660 s and the refresh at 3700 s would SERVFAIL instead of serving
; stale; the hold TTL is 30 s, not the floored remainder.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.example.com.
    SECTION ADDITIONAL
      ns.example.com. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 4
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 60 IN A 10.20.30.40
  ENTRY_END
RANGE_END
RANGE_BEGIN 5 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 300 IN A 10.20.30.40
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 3700

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl ede=3
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 30 IN A 10.20.30.40
ENTRY_END

SCENARIO_END

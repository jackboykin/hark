; hark: root-hints = 127.0.10.1
; hark: serve-stale-ttl = 3600
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN fresh bytes whose verdict cannot be renewed are not served as stale

; www.example A lives an hour, but the DS it was validated under lives ten
; seconds. At 20 s the verdict has lapsed and the DS cannot be fetched
; again, so the answer is SERVFAIL. The A itself has not expired: serving
; it would be no stale answer but fresh data with its validation dropped.
;
; Topology
;   root     127.0.10.1   delegates example. with a 10 s DS until step 2,
;                         then SERVFAILs
;   example  127.0.10.2   answers www A

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 10 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR SERVFAIL
    SECTION QUESTION
      example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 20

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

SCENARIO_END

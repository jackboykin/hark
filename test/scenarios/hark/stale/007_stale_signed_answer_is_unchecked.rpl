; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: serve-stale-ttl = 3600

SCENARIO_BEGIN A stale signed answer is served unchecked

; RFC 8767 §4: stale data is not validated; AD is off and EDE 3 set even
; where the signatures would still verify.

RANGE_BEGIN 0 4
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      leaf.example. IN A
    SECTION ANSWER
      leaf.example. 60 IN A 192.0.2.1
  ENTRY_END
RANGE_END

RANGE_BEGIN 5 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA SERVFAIL
    SECTION QUESTION
      leaf.example. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    leaf.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA AD NOERROR
  SECTION QUESTION
    leaf.example. IN A
  SECTION ANSWER
    leaf.example. 60 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 120

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    leaf.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl ede=3
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    leaf.example. IN A
  SECTION ANSWER
    leaf.example. 30 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

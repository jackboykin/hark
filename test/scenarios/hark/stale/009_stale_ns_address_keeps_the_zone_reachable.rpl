; hark: root-hints = 127.0.10.1
; hark: serve-stale-ttl = 3600

SCENARIO_BEGIN A stale nameserver address keeps its zone reachable

; RFC 8767 §4: the authority for the NS name fails, its A is 60 s past
; expiry; the walk uses the stale address, unverified, and the zone's own
; server answers a fresh name with no EDE.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ; example. is delegated to an out-of-bailiwick, unglued NS.
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.host.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      host. IN A
    SECTION AUTHORITY
      host. 86400 IN NS a.host.
    SECTION ADDITIONAL
      a.host. 86400 IN A 127.0.10.3
  ENTRY_END
RANGE_END

; host. authority: ns.host A lives 60 s, then the server fails.
RANGE_BEGIN 0 4
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN A
    SECTION ANSWER
      ns.host. 60 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN AAAA
    SECTION AUTHORITY
      host. 86400 IN SOA a.host. hm.host. 1 3600 600 86400 60
  ENTRY_END
RANGE_END

RANGE_BEGIN 5 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR AA SERVFAIL
    SECTION QUESTION
      ns.host. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      leaf.example. IN A
    SECTION ANSWER
      leaf.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      leaf2.example. IN A
    SECTION ANSWER
      leaf2.example. 30 IN A 192.0.2.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    leaf.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    leaf.example. IN A
  SECTION ANSWER
    leaf.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 120

; ns.host A is expired; the addr rule must refresh it and the host server fails.
STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD EDNS
  SECTION QUESTION
    leaf2.example. IN A
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    leaf2.example. IN A
  SECTION ANSWER
    leaf2.example. 30 IN A 192.0.2.2
ENTRY_END

SCENARIO_END

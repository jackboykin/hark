; hark: root-hints = 127.0.10.1
; hark: serve-stale-ttl = 3600
; hark: dnssec-zone = .
; hark: dnssec-zone = example.

SCENARIO_BEGIN bytes judged bogus are never served stale

; Stale hops go unjudged (their signatures may have expired), so a stale
; substitution must never reach bytes that already failed validation: that
; would serve a forgery, unsigned, with a stale EDE for cover. The forgery
; here has a 10 s TTL; the assigned bogus lifetime ends it at 5 s. Past its
; own TTL and inside the stale window, with the refresh failing (the server
; drops), the answer must still be SERVFAIL, not the forged address.
;
; Topology
;   root     127.0.10.1   delegates example. with a DS
;   example  127.0.10.2   forgery through step 2, silent from step 3

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
      example. 3600 IN DS PLACEHOLDER
    SECTION ADDITIONAL
      ns.example. 3600 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 10 IN A 192.0.2.66
      ; Hand-declared so the harness does not sign over it; key_tag 1
      ; matches no DNSKEY in example.'s generated set.
      www.example. 10 IN RRSIG A 13 2 10 20990101000000 20200101000000 1 example. AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.2

  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

; Past the forgery's own TTL, inside the stale window, server silent.
STEP 3 TIME_PASSES ELAPSE 20

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

SCENARIO_END

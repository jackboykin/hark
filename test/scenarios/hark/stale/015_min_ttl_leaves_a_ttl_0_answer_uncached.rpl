; hark: root-hints = 127.0.10.1
; hark: min-ttl = 60
; hark: qname-minimisation = no

SCENARIO_BEGIN min-ttl leaves a TTL-0 answer uncached

; A zero TTL is the authority saying "this transaction only" (RFC 1035
; 4.1.3, RFC 2181 8), not a short TTL to floor: the answer is served at 0
; and the second ask goes upstream again.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION ANSWER
      example.com. 0 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    example.com. IN A
  SECTION ANSWER
    example.com. 0 IN A 192.0.2.1
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 4 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 5 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example.com. IN A
ENTRY_END

SCENARIO_END

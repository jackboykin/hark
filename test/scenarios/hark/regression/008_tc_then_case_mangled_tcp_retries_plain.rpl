; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no

SCENARIO_BEGIN a mangled 0x20 echo over TCP earns one plain-case TCP retry

; UDP keeps the case but truncates, so the TCP retry still carries 0x20.
; That TCP echo comes back uppercased: a mismatch, which earns one more
; TCP query in plain case, where an echo in any case passes.
; 36 eligible letters: P(no mismatch) = 2^-36.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype UDP
    ADJUST copy_id copy_query
    REPLY QR AA TC NOERROR
    SECTION QUESTION
      abcdefghijklmnopqrstuvwxyz.example.com. IN A
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype TCP
    ADJUST copy_id copy_query force_upper_qname
    REPLY QR AA NOERROR
    SECTION QUESTION
      abcdefghijklmnopqrstuvwxyz.example.com. IN A
    SECTION ANSWER
      abcdefghijklmnopqrstuvwxyz.example.com. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    abcdefghijklmnopqrstuvwxyz.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    abcdefghijklmnopqrstuvwxyz.example.com. IN A
  SECTION ANSWER
    abcdefghijklmnopqrstuvwxyz.example.com. 3600 IN A 192.0.2.1
ENTRY_END

; UDP, TCP with 0x20, TCP plain: nothing more.
STEP 3 CHECK_MAX_QUERIES 3

SCENARIO_END

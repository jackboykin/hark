; hark: root-hints = 127.0.10.1
; hark: prefetch = yes

SCENARIO_BEGIN a failed refresh leaves the fact it would have replaced

; The authority answers SERVFAIL from step 5 on. The refresh at 59 s
; fails before the record's 61 s are up; the client at 60 s is still
; served the record, not the failure (Unbound keeps the good entry too).

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.example.com.
    SECTION ADDITIONAL
      ns.example.com. 86400 IN A 127.0.10.3
  ENTRY_END
RANGE_END
RANGE_BEGIN 0 4
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 61 IN A 10.20.30.40
  ENTRY_END
RANGE_END

RANGE_BEGIN 5 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA SERVFAIL
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 61 IN A 10.20.30.40
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 59

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 2 IN A 10.20.30.40
ENTRY_END

STEP 6 TIME_PASSES ELAPSE 1

STEP 7 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    com. IN A
ENTRY_END

STEP 8 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 9 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 10 CHECK_OUT_QUERY
ENTRY_BEGIN
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 11 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 12 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer ttl
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. 1 IN A 10.20.30.40
ENTRY_END

STEP 13 TIME_PASSES ELAPSE 1

STEP 14 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 15 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 16 CHECK_MAX_QUERIES 6

SCENARIO_END

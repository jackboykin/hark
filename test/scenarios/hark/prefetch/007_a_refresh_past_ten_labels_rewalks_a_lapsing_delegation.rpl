; hark: root-hints = 127.0.10.1
; hark: prefetch = yes

SCENARIO_BEGIN a refresh past ten labels re-walks a lapsing delegation

; The delegation at eleven labels lapses with the answer. No probe can
; place a cut that deep, so the refresh starts at com and follows the
; referral down again instead of failing on the lapsing cut.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      b.c.d.e.f.g.h.i.j.k.com. IN A
    SECTION AUTHORITY
      b.c.d.e.f.g.h.i.j.k.com. 60 IN NS ns.b.c.d.e.f.g.h.i.j.k.com.
    SECTION ADDITIONAL
      ns.b.c.d.e.f.g.h.i.j.k.com. 86400 IN A 127.0.10.3
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 900 IN SOA a.gtld.fake. hostmaster.com. 1 1800 900 604800 900
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a.b.c.d.e.f.g.h.i.j.k.com. IN A
    SECTION ANSWER
      a.b.c.d.e.f.g.h.i.j.k.com. 60 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    a.b.c.d.e.f.g.h.i.j.k.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a.b.c.d.e.f.g.h.i.j.k.com. IN A
  SECTION ANSWER
    a.b.c.d.e.f.g.h.i.j.k.com. 60 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 59

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    a.b.c.d.e.f.g.h.i.j.k.com. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a.b.c.d.e.f.g.h.i.j.k.com. IN A
  SECTION ANSWER
    a.b.c.d.e.f.g.h.i.j.k.com. 1 IN A 192.0.2.1
ENTRY_END

STEP 6 TIME_PASSES ELAPSE 1

STEP 7 CHECK_MAX_QUERIES 99

SCENARIO_END

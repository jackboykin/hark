; hark: root-hints = 127.0.10.1
; hark: dnssec-zone = .
; hark: dns64-prefix = 64:ff9b::/96

SCENARIO_BEGIN in a signed zone synthesis clears AD, CD=1 gets the proofs, bogus stays SERVFAIL

; `b.`'s negative carries a garbage SOA RRSIG (key_tag=1, unsigned by the harness).

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a. IN AAAA
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      a. 3600 IN NSEC b. A RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      a. IN A
    SECTION ANSWER
      a. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b. IN AAAA
    SECTION AUTHORITY
      . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
      . 3600 IN RRSIG SOA 13 0 3600 20990101000000 20200101000000 1 . AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      b. 3600 IN NSEC c. A RRSIG NSEC
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      b. IN A
    SECTION ANSWER
      b. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer authority
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    a. IN AAAA
  SECTION ANSWER
    a. 3600 IN AAAA 64:ff9b::c000:201
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO CD
  SECTION QUESTION
    a. IN AAAA
ENTRY_END

; AD=1 under CD=1: the entry was validated when cached.
STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer authority
  REPLY QR RD RA AD CD NOERROR
  SECTION QUESTION
    a. IN AAAA
  SECTION AUTHORITY
    . 3600 IN SOA root. nobody.invalid. 1 7200 3600 86400 3600
    a. 3600 IN NSEC b. A RRSIG NSEC
ENTRY_END

STEP 5 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    b. IN AAAA
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
  MATCH flags question answer
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    b. IN AAAA
ENTRY_END

SCENARIO_END

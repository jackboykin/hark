; hark: root-hints = 127.0.10.1
; hark: max-queries = 2
; sim-only: live, a UDP client is answered within 2 s or not at all, and the silent server's wait and retry outlast that

SCENARIO_BEGIN a zone whose cut the budget stopped looking up was never fully asked

; example.'s delegation lives 0 s, so each pass of the ask looks its cut
; up again. With a budget of two, the root referral and one silent send
; spend it, and the retry's cut lookup fails on the budget: the second
; server was never learned, let alone asked. The stop is the budget's,
; named, and nothing is held against the zone: asked again, it stops the
; same way.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 0 IN NS ns1.example.
      example. 0 IN NS ns2.example.
    SECTION ADDITIONAL
      ns1.example. 0 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode
    ADJUST drop
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=0
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD DO
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question ede=0
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example. IN A
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN a failed NS-address sub-resolution is retried by the next query
;
; The delegation is glueless and the NS name's own authority REFUSES its
; address until step 3. The first client SERVFAILs, and that client-facing
; failure is cached for its name. A second name under the same delegation,
; with no time passing, must resolve: the sub-resolution's failure is never
; cached.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.hoster.com.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      hoster.com. IN A
    SECTION AUTHORITY
      hoster.com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.hoster.com.
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 2
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      ns.hoster.com. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 3 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.hoster.com. IN A
    SECTION ANSWER
      ns.hoster.com. 3600 IN A 127.0.10.3
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.hoster.com. IN AAAA
    SECTION AUTHORITY
      hoster.com. 3600 IN SOA a.gtld.fake. hostmaster.fake. 1 7200 3600 86400 300
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example.com. IN A
    SECTION ANSWER
      mail.example.com. 3600 IN A 10.20.30.40
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 3 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    mail.example.com. IN A
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    mail.example.com. IN A
  SECTION ANSWER
    mail.example.com. 3600 IN A 10.20.30.40
ENTRY_END

SCENARIO_END

; hark: root-hints = 127.0.10.1
; hark: stagger-ms = 0

SCENARIO_BEGIN REFUSED from every NS is tried before surfacing (RFC 1034 §4.3.5)

; Both authoritative servers for example.com REFUSE everything (the textbook
; fully-lame delegation — both refuse the QMIN probe too, matching 005's
; shape). Hark must try BOTH before surfacing REFUSED to the stub. This is
; 005's all-fail sibling and carries the deterministic teeth 005 cannot:
; cold NS selection is randomized, so on code with NO fallthrough 005 still
; passes whenever the healthy NS is picked first (measured 15/30 on an
; ablated shouldTrySiblingNs). Here both NSes fail, so the leaf reaches both
; regardless of pick order — on no-fallthrough code one QUERY_LOG row is
; absent and STEP 3 fails every run.
;
; `stagger-ms = 0` forces the sequential server loop so exactly one NS is
; tried per hop, keeping the query-log count deterministic. Companion to 002
; (sole NS) and 005; see multi_NS_fallthrough.divergence.md.

; ── Fake root server ───────────────────────────────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      com. IN A
    SECTION AUTHORITY
      com. 86400 IN NS a.gtld.fake.
    SECTION ADDITIONAL
      a.gtld.fake. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

; ── Fake .com authority: delegates example.com to TWO NSes ─────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns1.example.com.
      example.com. 86400 IN NS ns2.example.com.
    SECTION ADDITIONAL
      ns1.example.com. 86400 IN A 127.0.10.3
      ns2.example.com. 86400 IN A 127.0.10.4
  ENTRY_END
RANGE_END

; ── ns1.example.com: REFUSED to everything ─────────────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      example.com. IN A
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END

; ── ns2.example.com: same — REFUSED to everything ──────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.4
  ENTRY_BEGIN
    MATCH opcode qname
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      example.com. IN A
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

; Both NSes REFUSE, so hark exhausts and surfaces REFUSED verbatim (002 pins
; the passthrough; same rcode either way — no order dependence).
STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA REFUSED
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

; Teeth: the leaf must have been queried at BOTH NSes (presence-only, so
; order-independent). Code that doesn't fall through on REFUSED queries
; only the first-picked NS, leaving one row absent.
STEP 3 CHECK_QUERY_LOG
ENTRY_BEGIN
  SECTION QUERY_LOG
    www.example.com. A 127.0.10.3
    www.example.com. A 127.0.10.4
ENTRY_END

SCENARIO_END

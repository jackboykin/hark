; hark: root-hints = 127.0.10.1
; hark: min-ttl = 3
; hark: qname-minimisation = no

SCENARIO_BEGIN an answer served from memory forgets a lapsed failure

; www fails at 0 s: held 5 s, backing off if it fails again before 10 s.
; At 6 s another question's chain stores www (TTL 1, floored to 3), and at
; 8 s www is answered from that memory. An answer forgets the failure, so
; www failing at 9 s opens a fresh 5 s window rather than doubling it: at
; 15 s the authority is asked again, and answers.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION AUTHORITY
      example.com. 86400 IN NS ns.example.com.
    SECTION ADDITIONAL
      ns.example.com. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      alias.example.com. IN A
    SECTION ANSWER
      alias.example.com. 60 IN CNAME www.example.com.
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 9
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA SERVFAIL
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END
RANGE_BEGIN 10 29
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 1 IN A 10.20.30.40
  ENTRY_END
RANGE_END
RANGE_BEGIN 30 39
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA SERVFAIL
    SECTION QUESTION
      www.example.com. IN A
  ENTRY_END
RANGE_END
RANGE_BEGIN 40 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example.com. IN A
    SECTION ANSWER
      www.example.com. 60 IN A 10.20.30.41
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 6

STEP 10 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    alias.example.com. IN A
ENTRY_END

; The chain's www is re-asked warm at 15 s through the newer address, so
; only the rcode is pinned here; step 21 shows what the chain stored.
STEP 11 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    alias.example.com. IN A
ENTRY_END

STEP 12 TIME_PASSES ELAPSE 2

STEP 20 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 21 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. IN A 10.20.30.40
ENTRY_END

STEP 22 TIME_PASSES ELAPSE 1

STEP 30 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 31 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question
  REPLY QR RD RA SERVFAIL
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 32 TIME_PASSES ELAPSE 6

STEP 40 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example.com. IN A
ENTRY_END

STEP 41 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example.com. IN A
  SECTION ANSWER
    www.example.com. IN A 10.20.30.41
ENTRY_END

SCENARIO_END

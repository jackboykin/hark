; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN UDP response with TC=1 triggers TCP retry per RFC 1035 §4.2.1

; A truncated UDP response (TC=1, no answer payload) must cause hark to
; retry the same query over TCP, where the auth returns the full answer.
; The bug-mode this catches: hark ignores TC and returns SERVFAIL or
; returns the truncated (empty) response to the client.

; ── Single auth at 127.0.10.1; UDP and TCP differ ──────────────────
RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1

  ; UDP: return QR + AA + TC + NOERROR with no records. The TC bit is
  ; the only payload; the client must move to TCP for the real answer.
  ENTRY_BEGIN
    MATCH opcode qname qtype udp
    ADJUST copy_id copy_query
    REPLY QR AA TC NOERROR
    SECTION QUESTION
      example.com. IN A
  ENTRY_END

  ; TCP: full answer. Hark's TCP retry path lands here.
  ENTRY_BEGIN
    MATCH opcode qname qtype tcp
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      example.com. IN A
    SECTION ANSWER
      example.com. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    example.com. IN A
  SECTION ANSWER
    example.com. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

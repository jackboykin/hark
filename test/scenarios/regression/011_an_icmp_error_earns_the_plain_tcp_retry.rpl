; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no
; sim-only: live, a real ICMP error needs a raw socket

SCENARIO_BEGIN an icmp error on the datagram earns the plain tcp retry

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH qname qtype UDP
    ADJUST bounce
    SECTION QUESTION
      icmp.example.com. IN A
  ENTRY_END
  ENTRY_BEGIN
    MATCH qname qtype TCP
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      icmp.example.com. IN A
    SECTION ANSWER
      icmp.example.com. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    icmp.example.com. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode answer question
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    icmp.example.com. IN A
  SECTION ANSWER
    icmp.example.com. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

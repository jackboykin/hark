; hark: root-hints = 127.0.10.1
; hark: qname-minimisation = no

SCENARIO_BEGIN a server with only an IPv6 address is asked over IPv6

; Live, this is the one scenario whose upstream sits behind a v6 socket.

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 3600 IN NS ns.example.
    SECTION ADDITIONAL
      ns.example. 3600 IN AAAA ::1
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS ::1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.1
ENTRY_END

SCENARIO_END

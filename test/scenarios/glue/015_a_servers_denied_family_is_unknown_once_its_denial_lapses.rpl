; hark: root-hints = 127.0.10.1

SCENARIO_BEGIN a server's denied family is unknown once its denial lapses

; example. is served by ns.host., unglued. ns.host. has an A that lives an
; hour and, at first, no AAAA: a denial that lives a minute. Each is its
; own fact with its own life. Past the minute the A still stands and the
; AAAA is unknown, which is not none; by then the host has gained one and
; its old address refuses. A walk that runs out of servers asks for what
; it does not know before it fails, and finds the new address, as a cold
; walk would. One that read the lapsed denial as standing, or took the A
; for all the host has, would fail.
;
; Topology
;   root     127.0.10.1   delegates example. to ns.host., no glue;
;                         host. to ns0.host., glued
;   host     127.0.10.2   ns.host. A; its AAAA denied, then ::1
;   example  127.0.10.3   answers at first, then refuses
;   example  ::1          answers

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.host.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      host. IN A
    SECTION AUTHORITY
      host. 86400 IN NS ns0.host.
    SECTION ADDITIONAL
      ns0.host. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN A
    SECTION ANSWER
      ns.host. 3600 IN A 127.0.10.3
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 3
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN AAAA
    SECTION AUTHORITY
      host. 60 IN SOA ns0.host. hostmaster.host. 1 7200 3600 86400 60
  ENTRY_END
RANGE_END

RANGE_BEGIN 4 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN AAAA
    SECTION ANSWER
      ns.host. 3600 IN AAAA ::1
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 3
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
RANGE_END

RANGE_BEGIN 4 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR REFUSED
    SECTION QUESTION
      example. IN A
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS ::1
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example. IN A
    SECTION ANSWER
      mail.example. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 61

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    mail.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    mail.example. IN A
  SECTION ANSWER
    mail.example. 3600 IN A 192.0.2.2
ENTRY_END

SCENARIO_END

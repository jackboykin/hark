; hark: root-hints = 127.0.10.1
; hark: stagger-ms = 50
; hark: client-timeout = 0.3

SCENARIO_BEGIN a walk with only a silent server known asks for the rest before the silence is out

; example. is served by ns.host., unglued, whose AAAA lives an hour and
; whose A a second. Nothing listens at the AAAA. Two seconds on the AAAA
; is all that is known of the host, so the walk sends there; when the
; reply is late and there is no other server to try, it asks for the
; family it does not know instead of sitting out the silence, and is
; answered at the A inside the client's patience. So is the first
; question, should the AAAA be the first family to arrive. A walk that
; held out for a server's full timeout while a family went unasked would
; answer too late for anyone to hear.
;
; Topology
;   root     127.0.10.1   delegates example. to ns.host., no glue;
;                         host. to ns0.host., glued
;   host     127.0.10.2   ns.host. A for a second, AAAA for an hour
;   example  127.0.10.3   answers
;   example  ::1          silent

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.1
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      example. IN A
    SECTION AUTHORITY
      example. 86400 IN NS ns.host.
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode subdomain
    ADJUST copy_id copy_query
    REPLY QR NOERROR
    SECTION QUESTION
      host. IN A
    SECTION AUTHORITY
      host. 86400 IN NS ns0.host.
    SECTION ADDITIONAL
      ns0.host. 86400 IN A 127.0.10.2
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.2
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN A
    SECTION ANSWER
      ns.host. 1 IN A 127.0.10.3
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      ns.host. IN AAAA
    SECTION ANSWER
      ns.host. 3600 IN AAAA ::1
  ENTRY_END
RANGE_END

RANGE_BEGIN 0 100
  ADDRESS 127.0.10.3
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      www.example. IN A
    SECTION ANSWER
      www.example. 3600 IN A 192.0.2.1
  ENTRY_END
  ENTRY_BEGIN
    MATCH opcode qname qtype
    ADJUST copy_id copy_query
    REPLY QR AA NOERROR
    SECTION QUESTION
      mail.example. IN A
    SECTION ANSWER
      mail.example. 3600 IN A 192.0.2.2
  ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    www.example. IN A
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    www.example. IN A
  SECTION ANSWER
    www.example. 3600 IN A 192.0.2.1
ENTRY_END

STEP 3 TIME_PASSES ELAPSE 2

STEP 4 QUERY
ENTRY_BEGIN
  REPLY RD
  SECTION QUESTION
    mail.example. IN A
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
  MATCH rcode question answer
  REPLY QR RD RA NOERROR
  SECTION QUESTION
    mail.example. IN A
  SECTION ANSWER
    mail.example. 3600 IN A 192.0.2.2
ENTRY_END

SCENARIO_END

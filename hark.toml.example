# hark configuration. Install as /etc/hark/hark.toml.

[server]
listen = ["127.0.0.1:53", "[::1]:53"]
clients = ["127.0.0.0/8", "::1/128"]
max-udp-payload = 1232        # largest EDNS0 buffer honored from clients
tcp-idle-timeout-ms = 5000    # idle TCP clients are closed after this
tcp-queries-per-conn = 128    # TCP connections are closed after this many queries
# user = 65534                # uid to drop to after binding :53. Numeric only
# group = 65534               # gid to drop to. Numeric only

[resolver]
dnssec = true
qname-minimization = true
dns64-prefix = ""             # NAT64 prefix such as "64:ff9b::/96", otherwise off
stagger-ms = 150              # wait before trying the next nameserver. 0 disables
max-queries = 100             # upstream queries one resolution may spend
root-hints = []               # "ip" or "ip:port" entries, otherwise the IANA roots
encrypted-transport = "off"   # "opportunistic" uses DoT where authorities offer it. Needs outbound port 853
stub-zones = []               # "<zone> <addr>..." entries such as "internal 192.168.1.1". Never validated

[cache]
size = 12582912               # bytes. Memory peaks near twice this
prefetch = false              # refetch answers asked for in the last tenth of their TTL
serve-stale-ttl = 0           # serve expired answers for this many seconds
min-ttl = 0                   # TTL floor
servfail-ttl = 5              # seconds a failed question answers from memory. Doubles while it keeps failing, up to 300

[rebinding]
enabled = true                # scrub private addresses from public-zone answers
allow-zones = []              # zones exempt from scrubbing, for split-horizon
extra-block = []              # more CIDRs to scrub
extra-allow = []              # CIDRs to exempt, such as ["127.0.0.0/8"] for DNSBLs

[logging]
queries = false               # log every query

; bench. is shaped like com.: 13 names in bailiwick, an A and an AAAA each.
; Both zones include this, the root as glue and bench. at its apex, and
; lib.sh binds the bench nsd to these addresses (V6=0 leaves out the AAAA).
bench.      172800 IN NS   ns1.bench.
bench.      172800 IN NS   ns2.bench.
bench.      172800 IN NS   ns3.bench.
bench.      172800 IN NS   ns4.bench.
bench.      172800 IN NS   ns5.bench.
bench.      172800 IN NS   ns6.bench.
bench.      172800 IN NS   ns7.bench.
bench.      172800 IN NS   ns8.bench.
bench.      172800 IN NS   ns9.bench.
bench.      172800 IN NS   ns10.bench.
bench.      172800 IN NS   ns11.bench.
bench.      172800 IN NS   ns12.bench.
bench.      172800 IN NS   ns13.bench.
ns1.bench.  172800 IN A    192.5.6.30
ns1.bench.  172800 IN AAAA 2001:503:a83e::2:30
ns2.bench.  172800 IN A    192.33.14.30
ns2.bench.  172800 IN AAAA 2001:503:231d::2:30

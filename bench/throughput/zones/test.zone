$TTL 3600
test.                   IN SOA  ns.test. admin.test. (
                                2026050700  ; serial
                                1800        ; refresh
                                900         ; retry
                                604800      ; expire
                                3600 )      ; minimum

test.                   IN NS   ns.test.
ns.test.                IN A    198.41.0.4

; Distinct address from the wildcard so the smoke test verifies the explicit
; path rather than passing on wildcard fallthrough.
smoke.test.             IN A    127.0.0.42

; Wildcard answers every other leaf query the bench drivers emit (cache-hit
; set, miss-heavy random names). Cache-hit behavior on the hark side is
; independent of which records are explicit here — once warm, queries don't
; reach NSD anyway.
*.test.                 IN A    127.0.0.1
